#!/usr/bin/env bash
set -Eeuo pipefail

export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
umask 077

readonly VERSION="2.97.0"
readonly ARCHIVE_NAME="gh_${VERSION}_linux_amd64.tar.gz"
readonly ARCHIVE_SHA256="a2c9b8497e1f85b1ad0dfcb78b5a622e098801b8e461e459e88e1ee12f018112"
readonly BINARY_SHA256="141507c337e8b202ad398550c3b73d72f5af92e86f71665214538a81efd4c409"
readonly URL="https://github.com/cli/cli/releases/download/v${VERSION}/${ARCHIVE_NAME}"
readonly TARGET="/usr/local/libexec/cpa-gh-attestation"

for command_name in curl sha256sum tar install mktemp rm awk grep sed; do
  command -v "$command_name" >/dev/null 2>&1 || {
    printf 'missing command: %s\n' "$command_name" >&2
    exit 1
  }
done

temp_dir="$(mktemp -d /tmp/cpa-gh-attestation.XXXXXX)"
trap 'rm -rf "$temp_dir"' EXIT
archive_path="${temp_dir}/${ARCHIVE_NAME}"
member="gh_${VERSION}_linux_amd64/bin/gh"

curl --fail --silent --show-error --location \
  --proto '=https' --tlsv1.2 \
  --retry 3 --retry-all-errors --retry-delay 2 \
  --connect-timeout 15 --max-time 300 \
  "$URL" -o "$archive_path"
printf '%s  %s\n' "$ARCHIVE_SHA256" "$archive_path" | sha256sum -c -

[[ "$(tar -tzf "$archive_path" | grep -Fxc "$member")" == "1" ]] || {
  printf 'GitHub CLI archive does not contain exactly one expected binary\n' >&2
  exit 1
}
tar -tvzf "$archive_path" "$member" | awk 'substr($1, 1, 1) == "-" {found=1} END {exit !found}' || {
  printf 'GitHub CLI archive member is not a regular file\n' >&2
  exit 1
}
tar -xzf "$archive_path" -C "$temp_dir" --no-same-owner --no-same-permissions "$member"
binary_path="${temp_dir}/${member}"
[[ -f "$binary_path" && ! -L "$binary_path" ]] || {
  printf 'extracted GitHub CLI is not a regular file\n' >&2
  exit 1
}
[[ "$(sha256sum "$binary_path" | awk '{print $1}')" == "$BINARY_SHA256" ]] || {
  printf 'GitHub CLI binary checksum mismatch\n' >&2
  exit 1
}

install -d -m 0755 /usr/local/libexec
install -m 0755 -o root -g root "$binary_path" "$TARGET"
[[ "$(sha256sum "$TARGET" | awk '{print $1}')" == "$BINARY_SHA256" ]] || {
  printf 'installed GitHub CLI checksum mismatch\n' >&2
  exit 1
}
"$TARGET" --version | sed -n '1p'
